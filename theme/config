# XPenguins theme "Vaporwave"
#
# Eight kinds of toon wander your desktop, none of them a penguin:
#
#   terminal   a CRT on legs, screen playing a sunset over a scrolling grid
#   cassette   a walking tape, reels turning as it goes
#   statue     a small Greek figure in a laurel wreath, arms long since gone
#   palm       a palm tree walking on its own roots, fronds swaying
#   dolphin    porpoises along in arcs instead of walking
#   car        a low 80s wedge coupe that drives instead of walking
#   flamingo   hot pink, long legs, stands on one when it stops
#   boombox    twin speakers pulsing, tape deck turning, antenna up
#
# Every toon implements all 18 activities XPenguins supports: walker, runner,
# faller, tumbler, climber, floater, explosion, squashed, zapped, splatted,
# angel, exit, and action0 through action5. (The man page says action0-6, but
# the binary only defines PENGUIN_ACTION0..PENGUIN_ACTION5 -- six of them.)
#
# Direction rows, verified by running xpenguins against a probe theme:
#   walker / runner  row 0 = moving left,  row 1 = moving right
#   zapped           row 0 = facing left,  row 1 = facing right
#   climber          row 0 = wall on the toon's left, row 1 = on its right

delay 60          # milliseconds between frames

define default
	width 30      # frame width
	height 30     # frame height
	frames 8      # frames per pixmap
	speed 4       # pixels per frame
	directions 1


# ---------------------------------------------------------------------
# terminal. Screen flashes red when falling and cuts to static when things go wrong.
# ---------------------------------------------------------------------
toon terminal
	number 3

	# getting about. walker and faller are the two every toon must have.
	define faller     pixmap faller.xpm  speed 3
	define walker     pixmap walker.xpm  directions 2 speed 4
	define runner     pixmap runner.xpm  directions 2 speed 9
	define climber    pixmap climber.xpm directions 2 speed 4
	define floater    pixmap floater.xpm speed 3 height 44
	define tumbler    pixmap tumbler.xpm speed 1 acceleration 1 terminal_velocity 8

	# ways to go. explosion is the tame one --no-blood falls back to.
	define explosion  pixmap explosion.xpm    width 40 height 40
	define squashed   pixmap squashed.xpm
	define splatted   pixmap splatted.xpm
	define zapped     pixmap zapped.xpm  directions 2
	define exit       pixmap exit.xpm
	define angel      pixmap angel.xpm   frames 4 width 36 speed 3

	# six idle actions, picked at random when a toon stops
	define action0    pixmap action0.xpm speed 0 loop -4   # each toon's own: screen, reels, fronds, wheels, speakers
	define action1    pixmap action1.xpm speed 0 loop -3   # glances the other way and back
	define action2    pixmap action2.xpm speed 0 loop -3   # crouches and springs
	define action3    pixmap action3.xpm speed 0 loop -4   # rocks slowly side to side
	define action4    pixmap action4.xpm speed 0 loop -2   # shivers
	define action5    pixmap action5.xpm speed 0 loop -2   # glitches into scanlines, then recovers

